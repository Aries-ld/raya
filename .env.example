# Required for external callers; comma-separated keys support rotation.
RAYA_API_KEYS=replace-with-a-long-random-key
RAYA_HOST=0.0.0.0
RAYA_PORT=8000
# auto tries CUDA, MPS, then CPU, including backend failures during inference.
RAYA_DEVICE=auto
RAYA_DTYPE=auto
RAYA_MODEL_PATH=models/raya-decision-v1
RAYA_PROCESSOR_PATH=models/qwen3.5-2b-processor
RAYA_MAX_INPUT_TOKENS=4096
RAYA_QUEUE_SIZE=8
RAYA_REQUEST_TIMEOUT=120
# By default only base64 data URLs. Optional comma-separated trusted HTTPS hosts.
RAYA_MEDIA_HOSTS=
# Inclusive duration limits. Can be tightened, but cannot exceed the API's 3–20s range.
RAYA_MIN_VIDEO_SECONDS=3
RAYA_MAX_VIDEO_SECONDS=20
# Sampling is fixed at Qwen's fps=1 policy. Threaded CPU decoding is fastest in local tests.
RAYA_VIDEO_DECODER=software
RAYA_VIDEO_DECODE_THREADS=8
RAYA_VIDEO_MAX_PIXELS=131072
RAYA_IMAGE_MAX_PIXELS=262144
